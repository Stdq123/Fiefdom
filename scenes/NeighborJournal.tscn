[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/NeighborJournal.gd" id="1_script"]

[sub_resource type="StyleBoxFlat" id="NoteCard"]
content_margin_left = 19.0
content_margin_top = 16.0
content_margin_right = 19.0
content_margin_bottom = 16.0
bg_color = Color(0.13, 0.19, 0.15, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.44, 0.45, 0.31, 1)
corner_radius_top_left = 5
corner_radius_top_right = 5
corner_radius_bottom_left = 5
corner_radius_bottom_right = 5

[node name="邻里手记" type="VBoxContainer"]
theme_override_constants/separation = 10
script = ExtResource("1_script")

[node name="Title" type="Label" parent="."]
layout_mode = 2
theme_override_colors/font_color = Color(0.96, 0.83, 0.58, 1)
theme_override_font_sizes/font_size = 25
text = "邻里手记"

[node name="Caption" type="Label" parent="."]
layout_mode = 2
theme_override_colors/font_color = Color(0.77, 0.81, 0.67, 1)
theme_override_font_sizes/font_size = 15
text = "初见、来往和约定会记在这里。"

[node name="Pages" type="HBoxContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 14

[node name="RosterCard" type="PanelContainer" parent="Pages"]
custom_minimum_size = Vector2(220, 0)
layout_mode = 2
theme_override_styles/panel = SubResource("NoteCard")

[node name="Stack" type="VBoxContainer" parent="Pages/RosterCard"]
layout_mode = 2
theme_override_constants/separation = 11

[node name="KnownCount" type="Label" parent="Pages/RosterCard/Stack"]
