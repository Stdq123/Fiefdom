filter_clip = true

[sub_resource type="AtlasTexture" id="GrownHerbs"]
atlas = ExtResource("5_herbs")
region = Rect2(44, 0, 44, 28)
filter_clip = true

[sub_resource type="StyleBoxFlat" id="Page"]
content_margin_left = 14.0
content_margin_top = 10.0
content_margin_right = 16.0
content_margin_bottom = 10.0
bg_color = Color(0.144, 0.209, 0.167, 1)
border_width_left = 3
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
