[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/RavineJournalPanel.gd" id="1_script"]
[ext_resource type="Texture2D" path="res://assets/world/creek-road-bridge.png" id="2_bridge"]
[ext_resource type="Texture2D" path="res://assets/world/ravine-forage.svg" id="3_forage"]
[ext_resource type="Texture2D" path="res://assets/world/ravine-art.png" id="4_ravine"]
[ext_resource type="Texture2D" path="res://assets/world/bamboo-herb-bed.svg" id="5_herbs"]

[sub_resource type="AtlasTexture" id="Bridge"]
atlas = ExtResource("2_bridge")
region = Rect2(111, 1, 62, 40)
filter_clip = true

[sub_resource type="AtlasTexture" id="Ford"]
atlas = ExtResource("3_forage")
region = Rect2(80, 0, 28, 28)
filter_clip = true

[sub_resource type="AtlasTexture" id="Lookout"]
atlas = ExtResource("4_ravine")
