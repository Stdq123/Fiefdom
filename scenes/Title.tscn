custom_minimum_size = Vector2(0, 108)
layout_mode = 2
mouse_filter = 2
accessibility_name = "采邑春秋"
texture = ExtResource("5_logo")
expand_mode = 1
stretch_mode = 5

[node name="Divider" type="HSeparator" parent="Center/Menu"]
custom_minimum_size = Vector2(0, 6)
layout_mode = 2
theme_override_styles/separator = SubResource("Style_rule")

[node name="Continue" type="Button" parent="Center/Menu"]
visible = false
