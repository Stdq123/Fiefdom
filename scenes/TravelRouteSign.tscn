[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/TravelRouteSign.gd" id="1_sign"]
[ext_resource type="Theme" path="res://resources/estate_hud_theme.tres" id="2_hud"]

[node name="TravelRouteSign" type="PanelContainer"]
process_mode = 3
visible = false
size_flags_horizontal = 3
mouse_filter = 2
theme = ExtResource("2_hud")
theme_type_variation = &"HudWell"
script = ExtResource("1_sign")

[node name="Lines" type="VBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 5

[node name="Heading" type="HBoxContainer" parent="Lines"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 6

[node name="Direction" type="Label" parent="Lines/Heading"]
unique_name_in_owner = true
custom_minimum_size = Vector2(30, 30)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
theme_type_variation = &"HudSealLabel"
theme_override_font_sizes/font_size = 18
text = "◆"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Destination" type="Label" parent="Lines/Heading"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_type_variation = &"HudBronzeInk"
theme_override_font_sizes/font_size = 17
vertical_alignment = 1
autowrap_mode = 3

[node name="NextStep" type="Label" parent="Lines"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.89, 0.89, 0.77, 1)
theme_override_font_sizes/font_size = 14
autowrap_mode = 3

[node name="CancelDirections" type="Button" parent="Lines"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 33)
layout_mode = 2
size_flags_horizontal = 8
mouse_default_cursor_shape = 2
theme_type_variation = &"HudButton"
theme_override_font_sizes/font_size = 14
text = "取消指路"
