theme_override_colors/font_color = Color(0.95, 0.82, 0.57, 1)
theme_override_font_sizes/font_size = 31
text = "堂屋衣架"

[node name="CloseMap" type="Button" parent="MapModal/Center/Panel/Stack/Header"]
unique_name_in_owner = true
layout_mode = 2
