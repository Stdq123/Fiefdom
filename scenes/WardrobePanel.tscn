[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/WardrobePanel.gd" id="1_panel"]
[ext_resource type="PackedScene" path="res://scenes/WardrobeFigure.tscn" id="2_figure"]
[ext_resource type="Theme" path="res://resources/estate_hud_theme.tres" id="3_theme"]
[ext_resource type="StyleBox" path="res://resources/estate_archive_frame.tres" id="4_frame"]

[node name="WardrobePanel" type="Control"]
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
theme = ExtResource("3_theme")
script = ExtResource("1_panel")
toggle_action = &""

[node name="MapModal" type="ColorRect" parent="."]
unique_name_in_owner = true
visible = false
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.06, 0.08, 0.066, 0.74)

[node name="Center" type="CenterContainer" parent="MapModal"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="MapModal/Center"]
custom_minimum_size = Vector2(900, 0)
layout_mode = 2
texture_filter = 1
theme_override_styles/panel = ExtResource("4_frame")

[node name="Stack" type="VBoxContainer" parent="MapModal/Center/Panel"]
