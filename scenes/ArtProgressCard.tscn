[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ArtProgressCard.gd" id="1_card"]

[node name="ArtProgressCard" type="PanelContainer"]
theme_type_variation = &"HudWell"
size_flags_horizontal = 3
mouse_filter = 2
script = ExtResource("1_card")

[node name="Inset" type="MarginContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/margin_left = 6
theme_override_constants/margin_top = 5
theme_override_constants/margin_right = 6
theme_override_constants/margin_bottom = 5

[node name="Paper" type="VBoxContainer" parent="Inset"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 5

[node name="Heading" type="HBoxContainer" parent="Inset/Paper"]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2
theme_override_constants/separation = 8

[node name="Seal" type="Label" parent="Inset/Paper/Heading"]
unique_name_in_owner = true
custom_minimum_size = Vector2(35, 34)
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"HudSealLabel"
theme_override_font_sizes/font_size = 23
horizontal_alignment = 1
vertical_alignment = 1

[node name="Activity" type="Label" parent="Inset/Paper/Heading"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.86, 0.89, 0.79, 1)
theme_override_font_sizes/font_size = 15
vertical_alignment = 1
autowrap_mode = 3

[node name="Level" type="Label" parent="Inset/Paper/Heading"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.99, 0.85, 0.61, 1)
theme_override_font_sizes/font_size = 16
vertical_alignment = 1

[node name="Meter" type="ProgressBar" parent="Inset/Paper"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 7)
layout_mode = 2
mouse_filter = 2
show_percentage = false

[node name="Experience" type="Label" parent="Inset/Paper"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.80, 0.84, 0.73, 1)
theme_override_font_sizes/font_size = 14
autowrap_mode = 3
