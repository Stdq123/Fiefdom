[gd_scene format=3]

[ext_resource type="Theme" path="res://resources/estate_hud_theme.tres" id="1_theme"]
[ext_resource type="Script" path="res://scripts/HUDVitals.gd" id="2_vitals"]
[ext_resource type="Script" path="res://scripts/VitalMeter.gd" id="3_meter"]

[node name="Vitals" type="PanelContainer"]
custom_minimum_size = Vector2(186, 0)
theme = ExtResource("1_theme")
theme_type_variation = &"HudRail"
script = ExtResource("2_vitals")

[node name="Stack" type="VBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 3

[node name="Health" type="HBoxContainer" parent="Stack"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 4

[node name="HealthIcon" type="TextureRect" parent="Stack/Health"]
