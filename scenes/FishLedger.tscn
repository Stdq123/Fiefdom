[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/FishLedger.gd" id="1_script"]
[ext_resource type="Theme" path="res://resources/estate_hud_theme.tres" id="2_theme"]
[ext_resource type="PackedScene" path="res://scenes/MarketReceipt.tscn" id="3_receipt"]

[node name="溪鱼簿" type="VBoxContainer"]
theme = ExtResource("2_theme")
theme_override_constants/separation = 10
script = ExtResource("1_script")

[node name="Heading" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Heading"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HudBronzeInk"
theme_override_font_sizes/font_size = 28
text = "溪鱼簿"

[node name="Summary" type="Label" parent="Heading"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.82, 0.86, 0.75, 1)
theme_override_font_sizes/font_size = 16
autowrap_mode = 3

[node name="Forecast" type="PanelContainer" parent="."]
layout_mode = 2
theme_type_variation = &"HudLacquerTray"

[node name="Stack" type="VBoxContainer" parent="Forecast"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Today" type="HBoxContainer" parent="Forecast/Stack"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Waters" type="Label" parent="Forecast/Stack/Today"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HudBronzeInk"
theme_override_font_sizes/font_size = 19
text = "今日钓点"

[node name="Readiness" type="Label" parent="Forecast/Stack/Today"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 16
autowrap_mode = 3

[node name="FindTeacher" type="Button" parent="Forecast/Stack/Today"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(0, 34)
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"HudButton"
mouse_default_cursor_shape = 2
text = "找蒲宁"

[node name="Sites" type="HBoxContainer" parent="Forecast/Stack"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="Receipt" parent="." instance=ExtResource("3_receipt")]
unique_name_in_owner = true
layout_mode = 2

[node name="Reading" type="ScrollContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
follow_focus = true
horizontal_scroll_mode = 0
