; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Fiefdom"
config/version="1.0.0"
run/main_scene="res://scenes/Title.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameEvents="*res://scripts/GameEvents.gd"
Global="*res://scripts/Global.gd"
ItemManager="*res://scripts/ItemManager.gd"
Preferences="*res://scripts/Preferences.gd"
AudioManager="*res://scripts/AudioManager.gd"
MapTravel="*res://scripts/MapTravel.gd"
EventManager="*res://scripts/EventManager.gd"
GamepadInput="*res://scripts/GamepadInput.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[editor]

export/convert_text_resources_to_binary=false

[input]

ui_toggle_debug={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":72,"key_label":0,"unicode":104,"location":0,"echo":false,"script":null)
]
}

[internationalization]

locale/include_text_server_data=true

[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="NPC"
2d_physics/layer_4="Enemy"

[rendering]

environment/defaults/default_clear_color=Color(0.20, 0.25, 0.17, 1)
textures/canvas_textures/default_texture_filter=0
